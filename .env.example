# ============================================================
# Tikè Ayiti — variables d'environnement
# Copier vers `.env` puis renseigner les secrets :
#   cp .env.example .env
# Ne JAMAIS committer `.env`.
# Voir docs/DEPLOYMENT.md pour la checklist de production.
# ============================================================

# ---------- Base de données ----------
# En dev (docker-compose.yml), DATABASE_URL est construite depuis
# POSTGRES_* par le compose ; en local hors Docker, utilisez
# DATABASE_URL directement.
POSTGRES_USER="tike"
POSTGRES_PASSWORD="change-me-in-production"
POSTGRES_DB="tikeayiti"
DATABASE_URL="postgresql://tike:tike@localhost:5432/tikeayiti"

# ---------- Sécurité / JWT ----------
JWT_SECRET="change-me-to-a-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
APP_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# ---------- API ----------
API_PORT=3001
NODE_ENV="development"
# Dossier des affiches uploadées (défaut : ./uploads depuis apps/api).
# En production Docker, monter un volume sur ce chemin.
UPLOAD_DIR="./uploads"

# ---------- Frontend / CORS ----------
# En production : "https://votre-domaine.ht" (et CORS_ORIGIN identique).
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# ---------- Billets QR ----------
QR_SECRET="change-me-to-another-random-secret-at-least-32-chars"

# ---------- Paiement manuel MonCash / NatCash ----------
# Numéros marchands qui reçoivent les transferts clients.
MERCHANT_MONCASH_NUMBER="+50900000000"
MERCHANT_NATCASH_NUMBER="+50900000000"
# Durée (heures) avant expiration d'une commande impayée.
PAYMENT_EXPIRY_HOURS="2"
# Cron de purge automatique des commandes expirées (toutes les 10 min).
PAYMENT_SWEEP_CRON="*/10 * * * *"

# ---------- (Futur) API officielles MonCash / NatCash ----------
MONCASH_API_URL="https://sandbox.moncashbutton.digicelgroup.com"
MONCASH_API_KEY=""
MONCASH_WEBHOOK_SECRET=""
NATCASH_API_URL="https://sandbox.natcash.com"
NATCASH_API_KEY=""
NATCASH_WEBHOOK_SECRET=""

# ---------- Emails (Resend) ----------
# Si RESEND_API_KEY + ADMIN_EMAIL sont renseignés, l'admin reçoit un
# email à chaque paiement manuel en attente de validation.
RESEND_API_KEY=""
RESEND_FROM="no-reply@tikeayiti.ht"
ADMIN_EMAIL=""

# ---------- Seed ----------
# Utilisés par `pnpm --filter @tike-ayiti/api seed`. À CHANGER en prod
# immédiatement après le premier démarrage.
SEED_ADMIN_EMAIL="admin@tikeayiti.ht"
SEED_ADMIN_PASSWORD="change-me-after-first-boot"

# ---------- Images (Cloudinary, optionnel) ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Production (docker-compose.prod.yml) ----------
# Domaine public : Caddy génère le HTTPS automatiquement.
# DNS requis : A ${DOMAIN} et A api.${DOMAIN} -> IP du VPS.
DOMAIN="tikeayiti.ht"

# ---------- Observabilité / rate limiting ----------
LOG_LEVEL="info"
RATE_LIMIT_TTL_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="100"
# Anti brute-force sur /auth/login et /auth/register (10 req/min par défaut).
AUTH_RATE_LIMIT_TTL_SECONDS="60"
AUTH_RATE_LIMIT_MAX_REQUESTS="10"
