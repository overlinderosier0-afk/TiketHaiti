# Copier vers .env puis adapter les valeurs
DATABASE_URL="postgresql://tike:tike@localhost:5432/tikeayiti"

# Secret JWT (générer un vrai secret en production, ex. `openssl rand -base64 64`)
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Secret HMAC pour signer les QR des billets
QR_SECRET="change-me-in-production"

# Secret partagé avec le fournisseur de paiement pour vérifier les webhooks (HMAC SHA256, en-tête x-signature)
WEBHOOK_SECRET="change-me-in-production"

# Sandbox uniquement : "true" pour accepter les webhooks sans signature (dev local)
WEBHOOK_SKIP_SIGNATURE="false"

# Paiement manuel (transfert MonCash/NatCash + validation admin) :
# numéros marchands affichés au checkout. Le client envoie le montant exact
# à ce numéro et recopie la référence de commande dans la note du transfert.
MERCHANT_MONCASH_NUMBER="+50900000000"
MERCHANT_NATCASH_NUMBER="+50900000000"

# Délai de paiement en heures avant annulation automatique d'une commande impayée
PAYMENT_EXPIRY_HOURS="2"

# Seed : compte admin de développement (jamais de secret réel versionné)
SEED_ADMIN_EMAIL="admin@tikeayiti.ht"
SEED_ADMIN_PASSWORD="Admin123!"
